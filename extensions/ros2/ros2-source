#!/bin/sh
# ROS 2 sourcing wrapper injected by the ros2-* Rockcraft extensions.
#
# Discovers and sources the ROS 2 installation under /opt/ros/, then the
# workspace overlay that the colcon plugin installs in /opt/ros/overlay (if
# any), and exec's the provided command.
#
# Usage: ros2-source <command> [args...]
#   e.g. ros2-source /opt/ros/jazzy/lib/demo_nodes_cpp/talker
#
# The ros2 wrapper builds on this script for ros2 CLI invocations.

set -e

_ros2_setup=""
# Glob expands in alphabetical order; ROS distros are named alphabetically
# in release order (Humble < Iron < Jazzy < Lyrical < …), so iterating without
# breaking means _ros2_setup ends up pointing at the latest installed distro.
# The workspace overlay is not a distro: skip it.
for _f in /opt/ros/*/setup.sh; do
    case "$_f" in
    /opt/ros/overlay/setup.sh) continue ;;
    esac
    if [ -f "$_f" ]; then
        _ros2_setup="$_f"
    fi
done

if [ -z "${_ros2_setup}" ]; then
    echo "ros2-source: no ROS 2 installation found under /opt/ros/" >&2
    exit 1
fi

# shellcheck disable=SC1090
. "${_ros2_setup}"
unset _f _ros2_setup

# The overlay's local_setup.sh does not chain to the underlay sourced above.
if [ -f /opt/ros/overlay/local_setup.sh ]; then
    # shellcheck disable=SC1091
    . /opt/ros/overlay/local_setup.sh
fi

exec "$@"
